# Copy to .env.local and fill in. Never commit .env.local. These keys are only used for the owner account.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
# The HeyGen avatar used as the AI presenter (its id from your HeyGen account)
HEYGEN_AVATAR_ID=
# Optional overrides
# GEMINI_MODEL=gemini-flash-latest   (gemini-pro-latest needs a paid Gemini plan)
# Used when the main model is busy or not answering
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# ELEVENLABS_MODEL=eleven_v3
# Monthly character allowance of your ElevenLabs plan (used when the key cannot read it)
# ELEVENLABS_MONTHLY_CHARS=10000
# Voice per language (pick ones that match your HeyGen avatar). Defaults: Daniel, Brian.
# Indian voices need a paid ElevenLabs plan, e.g. Arjun English and Arjun Telugu:
# ELEVENLABS_VOICE_EN=hEVeuEwuN5rfDgwQ85v8
# ELEVENLABS_VOICE_TE=614hXxJLzZgeC6BDovkb
# Any language by its code: ELEVENLABS_VOICE_HI, _TA, _KN, _ML, _MR, _BN, _GU, _OR (default: Brian, multilingual)
# Prices in rupees used for the cost shown on each story and in the Rundown (estimates of the paid plans)
# GEMINI_INR_PER_1M_INPUT_TOKENS=25
# GEMINI_INR_PER_1M_OUTPUT_TOKENS=210
# ELEVENLABS_INR_PER_1K_CHARS=15
# HEYGEN_INR_PER_MINUTE=100
# Accounts: the first person to sign up is the owner; everyone else is approved by the owner. Every account's videos
# use the keys above (the app never shows or takes a key). Signs sign-ins; made in data/session-secret if unset.
# SESSION_SECRET=
# Forgot password: reset links are emailed from your own mail account (until set, they print in the server's terminal).
# Gmail: turn on 2-Step Verification, make an App Password at https://myaccount.google.com/apppasswords, then:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=the 16-letter app password
# MAIL_FROM=Dashavani Studio <you@gmail.com>
# The studio's public address, used in emailed links once it is online (e.g. https://studio.example.com)
# PUBLIC_URL=
# YouTube upload: a Google Cloud OAuth client of type "Desktop app" with the YouTube Data API v3 enabled.
# Then run npm run youtube:auth once and paste the YOUTUBE_REFRESH_TOKEN line it prints.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Limits: stories an editor may file a day (default 20); a monthly spend limit in rupees for the whole studio (off unless set)
# DAILY_STORIES=20
# MONTHLY_CAP_INR=2000
